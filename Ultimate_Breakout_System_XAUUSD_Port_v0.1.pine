//@version=6
strategy(
     "Ultimate Breakout System — XAUUSD Port v0.1",
     shorttitle = "UBS XAU v0.1",
     overlay = true,
     pyramiding = 0,
     calc_on_every_tick = true,
     process_orders_on_close = false,
     initial_capital = 10000,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value = 1
)

// ============================================================================
// ULTIMATE BREAKOUT SYSTEM
// TradingView / Pine Script v6 Port
//
// Purpose:
// - Rebuild the core breakout logic of the MQL5 EA for TradingView.
// - This is NOT a byte-for-byte MT5 conversion.
// - Broker/account/MQL5-specific APIs are intentionally excluded.
//
// Initial target:
// - XAUUSD
// - Support / Resistance breakout
// - ATR volatility breakout
// - Preventive false-breakout filtering
// - SL / TP
// - Break-even
// - Trailing stop
// - Visual levels
// - Alerts
// ============================================================================


// ============================================================================
// 1. GENERAL
// ============================================================================

const string G_GENERAL = "01 — General"

bool allowLong =
     input.bool(true, "Allow Long", group = G_GENERAL)

bool allowShort =
     input.bool(true, "Allow Short", group = G_GENERAL)

string engineMode =
     input.string(
         "Support / Resistance",
         "Engine",
         options = [
             "Support / Resistance",
             "Volatility Breakout"
         ],
         group = G_GENERAL
     )


// ============================================================================
// 2. SUPPORT / RESISTANCE BREAKOUT
// ============================================================================

const string G_SR = "02 — Support / Resistance Breakout"

int leftStrength =
     input.int(
         2,
         "Pivot Left Strength",
         minval = 1,
         group = G_SR
     )

int rightStrength =
     input.int(
         2,
         "Pivot Right Strength",
         minval = 1,
         group = G_SR
     )

int maxPivotAge =
     input.int(
         250,
         "Maximum Pivot Age",
         minval = 1,
         group = G_SR
     )

float minDistance =
     input.float(
         0.90,
         "Minimum Price Distance From Pivot",
         minval = 0.0,
         step = 0.01,
         group = G_SR,
         tooltip =
             "สำหรับ XAUUSD ใช้เป็นระยะราคาโดยตรง เช่น 0.90 = $0.90"
     )

float buyBuffer =
     input.float(
         0.20,
         "Buy Breakout Buffer",
         minval = 0.0,
         step = 0.01,
         group = G_SR
     )

float sellBuffer =
     input.float(
         0.40,
         "Sell Breakout Buffer",
         minval = 0.0,
         step = 0.01,
         group = G_SR
     )


// ============================================================================
// 3. VOLATILITY BREAKOUT
// ============================================================================

const string G_VOL = "03 — Volatility Breakout"

int volCandles =
     input.int(
         1,
         "Candles To Monitor",
         minval = 1,
         maxval = 20,
         group = G_VOL
     )

int volAtrPeriod =
     input.int(
         21,
         "ATR Period",
         minval = 1,
         group = G_VOL
     )

float devFactor =
     input.float(
         2.4,
         "Deviation Factor",
         minval = 0.1,
         step = 0.1,
         group = G_VOL
     )

float minMove =
     input.float(
         0.0,
         "Minimum Move",
         minval = 0.0,
         step = 0.01,
         group = G_VOL
     )


// ============================================================================
// 4. FALSE BREAKOUT FILTER
// ============================================================================

const string G_FB = "04 — Preventive False Breakout Filter"

bool fbEnabled =
     input.bool(
         true,
         "Enable Filter",
         group = G_FB
     )

int trendMaPeriod =
     input.int(
         0,
         "SMA Period — 0 disables",
         minval = 0,
         group = G_FB
     )

bool requireTrendAlignment =
     input.bool(
         false,
         "Require Price / SMA Alignment",
         group = G_FB
     )

bool requireTrendSlope =
     input.bool(
         false,
         "Require SMA Slope",
         group = G_FB
     )

int momentumBars =
     input.int(
         0,
         "Momentum Bars",
         minval = 0,
         maxval = 20,
         group = G_FB
     )

int minDirectionalBars =
     input.int(
         0,
         "Minimum Directional Bars",
         minval = 0,
         maxval = 20,
         group = G_FB
     )

float minBodyPercent =
     input.float(
         0.0,
         "Minimum Candle Body %",
         minval = 0.0,
         maxval = 100.0,
         step = 1.0,
         group = G_FB
     )

float maxBreakoutWickBody =
     input.float(
         1.5,
         "Maximum Breakout Wick / Body",
         minval = 0.0,
         step = 0.1,
         group = G_FB,
         tooltip = "0 disables this filter"
     )


// ============================================================================
// 5. CONFIRMATION
// ============================================================================

const string G_CONFIRM = "05 — Higher-Timeframe Confirmation"

bool useConfirm1 =
     input.bool(
         false,
         "Enable Confirmation 1",
         group = G_CONFIRM,
         inline = "C1"
     )

string confirmTf1 =
     input.timeframe(
         "5",
         "",
         group = G_CONFIRM,
         inline = "C1"
     )

bool useConfirm2 =
     input.bool(
         false,
         "Enable Confirmation 2",
         group = G_CONFIRM,
         inline = "C2"
     )

string confirmTf2 =
     input.timeframe(
         "15",
         "",
         group = G_CONFIRM,
         inline = "C2"
     )

bool useConfirm3 =
     input.bool(
         false,
         "Enable Confirmation 3",
         group = G_CONFIRM,
         inline = "C3"
     )

string confirmTf3 =
     input.timeframe(
         "60",
         "",
         group = G_CONFIRM,
         inline = "C3"
     )


// ============================================================================
// 6. EXIT MANAGEMENT
// ============================================================================

const string G_EXIT = "06 — Exit Management"

float stopDistance =
     input.float(
         11.50,
         "Initial Stop Distance",
         minval = 0.01,
         step = 0.10,
         group = G_EXIT
     )

float targetDistance =
     input.float(
         13.00,
         "Initial Target Distance",
         minval = 0.01,
         step = 0.10,
         group = G_EXIT
     )

bool useBreakEven =
     input.bool(
         true,
         "Use Break-even",
         group = G_EXIT
     )

float breakEvenStart =
     input.float(
         2.50,
         "Break-even Trigger",
         minval = 0.0,
         step = 0.10,
         group = G_EXIT
     )

float breakEvenExtra =
     input.float(
         0.0,
         "Break-even Extra",
         step = 0.10,
         group = G_EXIT
     )

bool useTrailing =
     input.bool(
         true,
         "Use Trailing Stop",
         group = G_EXIT
     )

float trailStart =
     input.float(
         2.50,
         "Trailing Start",
         minval = 0.0,
         step = 0.10,
         group = G_EXIT
     )

float trailDistance =
     input.float(
         7.50,
         "Trailing Distance",
         minval = 0.01,
         step = 0.10,
         group = G_EXIT
     )


// ============================================================================
// 7. SESSION
// ============================================================================

const string G_SESSION = "07 — Trading Session"

bool useSession =
     input.bool(
         false,
         "Use Session Filter",
         group = G_SESSION
     )

string tradingSession =
     input.session(
         "0000-2359",
         "Trading Session",
         group = G_SESSION
     )

bool sessionOK =
     not useSession or
     not na(time(timeframe.period, tradingSession))


// ============================================================================
// 8. PIVOT ENGINE
// ============================================================================

float pivotHigh =
     ta.pivothigh(
         high,
         leftStrength,
         rightStrength
     )

float pivotLow =
     ta.pivotlow(
         low,
         leftStrength,
         rightStrength
     )

var float activeHigh = na
var float activeLow = na

var int activeHighBar = na
var int activeLowBar = na

if not na(pivotHigh)
    activeHigh := pivotHigh
    activeHighBar := bar_index - rightStrength

if not na(pivotLow)
    activeLow := pivotLow
    activeLowBar := bar_index - rightStrength


// ============================================================================
// 9. PIVOT AGE
// ============================================================================

int highAge =
     na(activeHighBar) ?
     1000000 :
     bar_index - activeHighBar

int lowAge =
     na(activeLowBar) ?
     1000000 :
     bar_index - activeLowBar

bool highAgeOK =
     highAge <= maxPivotAge

bool lowAgeOK =
     lowAge <= maxPivotAge


// ============================================================================
// 10. BREAKOUT LEVELS
// ============================================================================

float buyEntry =
     na(activeHigh) ?
     na :
     activeHigh + buyBuffer

float sellEntry =
     na(activeLow) ?
     na :
     activeLow - sellBuffer

bool buyDistanceOK =
     not na(activeHigh) and
     activeHigh - close >= minDistance

bool sellDistanceOK =
     not na(activeLow) and
     close - activeLow >= minDistance


// ============================================================================
// 11. PREVENTIVE FALSE-BREAKOUT FILTER
// ============================================================================

float trendSma =
     trendMaPeriod >= 2 ?
     ta.sma(close, trendMaPeriod) :
     na

float previousTrendSma =
     trendMaPeriod >= 2 ?
     trendSma[1] :
     na


// Directional bars
int bullBars = 0
int bearBars = 0

if momentumBars > 0
    bullBars := 0
    bearBars := 0

    for i = 1 to momentumBars
        bullBars += close[i] > open[i] ? 1 : 0
        bearBars += close[i] < open[i] ? 1 : 0


// Latest completed candle anatomy
float lastRange =
     high[1] - low[1]

float lastBody =
     math.abs(close[1] - open[1])

float bodyPercent =
     lastRange > 0 ?
     lastBody / lastRange * 100.0 :
     0.0

float upperWick =
     high[1] - math.max(open[1], close[1])

float lowerWick =
     math.min(open[1], close[1]) - low[1]

float upperWickBody =
     lastBody > 0 ?
     upperWick / lastBody :
     999.0

float lowerWickBody =
     lastBody > 0 ?
     lowerWick / lastBody :
     999.0


bool longFilter =
     not fbEnabled or
     (
         (
             not requireTrendAlignment or
             trendMaPeriod < 2 or
             close[1] > trendSma[1]
         ) and
         (
             not requireTrendSlope or
             trendMaPeriod < 2 or
             trendSma[1] > trendSma[2]
         ) and
         (
             momentumBars <= 0 or
             minDirectionalBars <= 0 or
             bullBars >= math.min(
                 minDirectionalBars,
                 momentumBars
             )
         ) and
         (
             minBodyPercent <= 0 or
             (
                 close[1] > open[1] and
                 bodyPercent >= minBodyPercent
             )
         ) and
         (
             maxBreakoutWickBody <= 0 or
             upperWickBody <= maxBreakoutWickBody
         )
     )

bool shortFilter =
     not fbEnabled or
     (
         (
             not requireTrendAlignment or
             trendMaPeriod < 2 or
             close[1] < trendSma[1]
         ) and
         (
             not requireTrendSlope or
             trendMaPeriod < 2 or
             trendSma[1] < trendSma[2]
         ) and
         (
             momentumBars <= 0 or
             minDirectionalBars <= 0 or
             bearBars >= math.min(
                 minDirectionalBars,
                 momentumBars
             )
         ) and
         (
             minBodyPercent <= 0 or
             (
                 close[1] < open[1] and
                 bodyPercent >= minBodyPercent
             )
         ) and
         (
             maxBreakoutWickBody <= 0 or
             lowerWickBody <= maxBreakoutWickBody
         )
     )


// ============================================================================
// 12. HIGHER-TIMEFRAME CONFIRMATION
// ============================================================================

float confirmClose1 =
     request.security(
         syminfo.tickerid,
         confirmTf1,
         close[1],
         lookahead = barmerge.lookahead_off
     )

float confirmClose2 =
     request.security(
         syminfo.tickerid,
         confirmTf2,
         close[1],
         lookahead = barmerge.lookahead_off
     )

float confirmClose3 =
     request.security(
         syminfo.tickerid,
         confirmTf3,
         close[1],
         lookahead = barmerge.lookahead_off
     )

bool confirmLong =
     (
         not useConfirm1 or
         (
             not na(buyEntry) and
             confirmClose1 < buyEntry
         )
     ) and
     (
         not useConfirm2 or
         (
             not na(buyEntry) and
             confirmClose2 < buyEntry
         )
     ) and
     (
         not useConfirm3 or
         (
             not na(buyEntry) and
             confirmClose3 < buyEntry
         )
     )

bool confirmShort =
     (
         not useConfirm1 or
         (
             not na(sellEntry) and
             confirmClose1 > sellEntry
         )
     ) and
     (
         not useConfirm2 or
         (
             not na(sellEntry) and
             confirmClose2 > sellEntry
         )
     ) and
     (
         not useConfirm3 or
         (
             not na(sellEntry) and
             confirmClose3 > sellEntry
         )
     )


// ============================================================================
// 13. SUPPORT / RESISTANCE ENTRY CONDITIONS
// ============================================================================

bool longSetupSR =
     engineMode == "Support / Resistance" and
     allowLong and
     sessionOK and
     highAgeOK and
     buyDistanceOK and
     longFilter and
     confirmLong and
     not na(buyEntry)

bool shortSetupSR =
     engineMode == "Support / Resistance" and
     allowShort and
     sessionOK and
     lowAgeOK and
     sellDistanceOK and
     shortFilter and
     confirmShort and
     not na(sellEntry)


// ============================================================================
// 14. VOLATILITY BREAKOUT
// ============================================================================

float volAtr =
     ta.atr(volAtrPeriod)

float strongestMove =
     close[1] - open[1]

if volCandles > 1
    for i = 2 to volCandles
        float candidateMove =
             close[1] - open[i]

        if math.abs(candidateMove) >
           math.abs(strongestMove)
            strongestMove := candidateMove

bool volMagnitudeOK =
     math.abs(strongestMove) >= minMove and
     math.abs(strongestMove) >= devFactor * volAtr[1]

bool longSetupVOL =
     engineMode == "Volatility Breakout" and
     allowLong and
     sessionOK and
     strongestMove > 0 and
     volMagnitudeOK and
     longFilter

bool shortSetupVOL =
     engineMode == "Volatility Breakout" and
     allowShort and
     sessionOK and
     strongestMove < 0 and
     volMagnitudeOK and
     shortFilter


// ============================================================================
// 15. ORDERS — SUPPORT / RESISTANCE
// ============================================================================

if engineMode == "Support / Resistance"
    if longSetupSR and strategy.position_size <= 0
        strategy.entry(
             "LONG",
             strategy.long,
             stop = buyEntry,
             comment = "S/R Buy Breakout"
        )

    if shortSetupSR and strategy.position_size >= 0
        strategy.entry(
             "SHORT",
             strategy.short,
             stop = sellEntry,
             comment = "S/R Sell Breakout"
        )


// Cancel obsolete setups when no longer admissible.
if engineMode == "Support / Resistance"
    if not longSetupSR
        strategy.cancel("LONG")

    if not shortSetupSR
        strategy.cancel("SHORT")


// ============================================================================
// 16. ORDERS — VOLATILITY BREAKOUT
// ============================================================================

if engineMode == "Volatility Breakout"
    if longSetupVOL and strategy.position_size == 0
        strategy.entry(
             "LONG",
             strategy.long,
             comment = "Volatility Long"
        )

    if shortSetupVOL and strategy.position_size == 0
        strategy.entry(
             "SHORT",
             strategy.short,
             comment = "Volatility Short"
        )


// ============================================================================
// 17. POSITION MANAGEMENT
// ============================================================================

var float longStop = na
var float longTarget = na

var float shortStop = na
var float shortTarget = na


// ----- LONG ---------------------------------------------------------------

if strategy.position_size > 0

    float entryPrice =
         strategy.position_avg_price

    if strategy.position_size[1] <= 0
        longStop :=
             entryPrice - stopDistance

        longTarget :=
             entryPrice + targetDistance


    // Break-even
    if useBreakEven and
       high - entryPrice >= breakEvenStart

        float beStop =
             entryPrice + breakEvenExtra

        longStop :=
             na(longStop) ?
             beStop :
             math.max(longStop, beStop)


    // Trailing
    if useTrailing and
       high - entryPrice >= trailStart

        float trailingCandidate =
             high - trailDistance

        longStop :=
             na(longStop) ?
             trailingCandidate :
             math.max(
                 longStop,
                 trailingCandidate
             )


    strategy.exit(
         "LONG EXIT",
         from_entry = "LONG",
         stop = longStop,
         limit = longTarget
    )


// Reset when long is gone
if strategy.position_size <= 0
    longStop := na
    longTarget := na


// ----- SHORT --------------------------------------------------------------

if strategy.position_size < 0

    float entryPrice =
         strategy.position_avg_price

    if strategy.position_size[1] >= 0
        shortStop :=
             entryPrice + stopDistance

        shortTarget :=
             entryPrice - targetDistance


    // Break-even
    if useBreakEven and
       entryPrice - low >= breakEvenStart

        float beStop =
             entryPrice - breakEvenExtra

        shortStop :=
             na(shortStop) ?
             beStop :
             math.min(shortStop, beStop)


    // Trailing
    if useTrailing and
       entryPrice - low >= trailStart

        float trailingCandidate =
             low + trailDistance

        shortStop :=
             na(shortStop) ?
             trailingCandidate :
             math.min(
                 shortStop,
                 trailingCandidate
             )


    strategy.exit(
         "SHORT EXIT",
         from_entry = "SHORT",
         stop = shortStop,
         limit = shortTarget
    )


// Reset when short is gone
if strategy.position_size >= 0
    shortStop := na
    shortTarget := na


// ============================================================================
// 18. VISUALS
// ============================================================================

plot(
     engineMode == "Support / Resistance" ?
     activeHigh :
     na,
     "Resistance Pivot",
     style = plot.style_stepline,
     linewidth = 2
)

plot(
     engineMode == "Support / Resistance" ?
     activeLow :
     na,
     "Support Pivot",
     style = plot.style_stepline,
     linewidth = 2
)

plot(
     engineMode == "Support / Resistance" ?
     buyEntry :
     na,
     "Buy Stop Level",
     style = plot.style_linebr
)

plot(
     engineMode == "Support / Resistance" ?
     sellEntry :
     na,
     "Sell Stop Level",
     style = plot.style_linebr
)

plot(
     trendMaPeriod >= 2 ?
     trendSma :
     na,
     "False-Breakout SMA"
)


// Entry markers

plotshape(
     longSetupSR,
     title = "Long Setup",
     style = shape.triangleup,
     location = location.belowbar,
     size = size.tiny,
     text = "L"
)

plotshape(
     shortSetupSR,
     title = "Short Setup",
     style = shape.triangledown,
     location = location.abovebar,
     size = size.tiny,
     text = "S"
)

plotshape(
     longSetupVOL,
     title = "Volatility Long",
     style = shape.circle,
     location = location.belowbar,
     size = size.tiny,
     text = "VOL"
)

plotshape(
     shortSetupVOL,
     title = "Volatility Short",
     style = shape.circle,
     location = location.abovebar,
     size = size.tiny,
     text = "VOL"
)


// ============================================================================
// 19. ALERTS
// ============================================================================

alertcondition(
     longSetupSR,
     "UBS Long Breakout Setup",
     "Ultimate Breakout System: LONG breakout setup"
)

alertcondition(
     shortSetupSR,
     "UBS Short Breakout Setup",
     "Ultimate Breakout System: SHORT breakout setup"
)

alertcondition(
     longSetupVOL,
     "UBS Volatility Long",
     "Ultimate Breakout System: bullish volatility breakout"
)

alertcondition(
     shortSetupVOL,
     "UBS Volatility Short",
     "Ultimate Breakout System: bearish volatility breakout"
)


// ============================================================================
// 20. STATUS PANEL
// ============================================================================

var table dashboard =
     table.new(
         position.top_right,
         2,
         8,
         border_width = 1
     )

if barstate.islast

    table.cell(
         dashboard,
         0,
         0,
         "ULTIMATE BREAKOUT"
    )

    table.cell(
         dashboard,
         1,
         0,
         "XAU PORT"
    )

    table.cell(
         dashboard,
         0,
         1,
         "Engine"
    )

    table.cell(
         dashboard,
         1,
         1,
         engineMode
    )

    table.cell(
         dashboard,
         0,
         2,
         "Resistance"
    )

    table.cell(
         dashboard,
         1,
         2,
         na(activeHigh) ?
         "NA" :
         str.tostring(
             activeHigh,
             format.mintick
         )
    )

    table.cell(
         dashboard,
         0,
         3,
         "Support"
    )

    table.cell(
         dashboard,
         1,
         3,
         na(activeLow) ?
         "NA" :
         str.tostring(
             activeLow,
             format.mintick
         )
    )

    table.cell(
         dashboard,
         0,
         4,
         "ATR"
    )

    table.cell(
         dashboard,
         1,
         4,
         str.tostring(
             volAtr,
             format.mintick
         )
    )

    table.cell(
         dashboard,
         0,
         5,
         "Long Filter"
    )

    table.cell(
         dashboard,
         1,
         5,
         longFilter ?
         "PASS" :
         "BLOCK"
    )

    table.cell(
         dashboard,
         0,
         6,
         "Short Filter"
    )

    table.cell(
         dashboard,
         1,
         6,
         shortFilter ?
         "PASS" :
         "BLOCK"
    )

    table.cell(
         dashboard,
         0,
         7,
         "Position"
    )

    string positionText =
         strategy.position_size > 0 ?
         "LONG" :
         strategy.position_size < 0 ?
         "SHORT" :
         "FLAT"

    table.cell(
         dashboard,
         1,
         7,
         positionText
    )
